# Production Environment
OPENROUTER_API_KEY=replace-with-your-production-key
JWT_SECRET_KEY=replace-with-a-long-random-secret-prod
ENVIRONMENT=production
DATABASE_URL=postgresql://<user>:<password>@<postgres-host>:5432/<database>?sslmode=require
STORAGE_PROVIDER=azure_blob
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER=ai-ops-datasets
LOG_JSON=true
DOCS_ENABLED=false
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=5
RAG_ENABLED=true
HEALTH_REQUIRE_LLM=true
CORS_ALLOWED_ORIGINS=https://your-frontend.azurecontainerapps.io
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
