# Production Environment
OPENROUTER_API_KEY=replace-with-your-production-key
JWT_SECRET_KEY=replace-with-a-long-random-secret-prod
ENVIRONMENT=production
DATABASE_URL=sqlite:///ai_ops_copilot_prod.db
STORAGE_PROVIDER=azure
AZURE_BLOB_CONNECTION_STRING=replace-with-production-connection-string
AZURE_BLOB_CONTAINER=ai-ops-datasets-prod
LOG_JSON=true
DOCS_ENABLED=false
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=5
RAG_ENABLED=true
HEALTH_REQUIRE_LLM=true
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example.com
