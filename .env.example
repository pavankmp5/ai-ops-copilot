# Base
OPENROUTER_API_KEY=replace-with-your-OPENROUTER_KEY
JWT_SECRET_KEY=replace-with-a-long-random-secret
ENVIRONMENT=development
DATABASE_URL=sqlite:///ai_ops_copilot.db
STORAGE_PROVIDER=local
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=ai-ops-datasets
LOG_JSON=false
DOCS_ENABLED=true
LLM_TIMEOUT_SECONDS=5
LLM_MAX_RETRIES=0
RAG_ENABLED=true
HEALTH_REQUIRE_LLM=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Production recommendations:
# ENVIRONMENT=production
# DOCS_ENABLED=false
# LOG_JSON=true
# HEALTH_REQUIRE_LLM=true
# RAG_ENABLED=true
# OPENROUTER_API_KEY=replace-with-your-production-key
# JWT_SECRET_KEY=replace-with-a-long-random-secret
# CORS_ALLOWED_ORIGINS=["https://your-frontend-domain.example.com"]
