# Development Environment
OPENROUTER_API_KEY=replace-with-your-OPENROUTER_KEY
JWT_SECRET_KEY=replace-with-a-long-random-secret-dev
ENVIRONMENT=development
DATABASE_URL=sqlite:///ai_ops_copilot_dev.db
STORAGE_PROVIDER=local
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=ai-ops-datasets-dev
LOG_JSON=false
DOCS_ENABLED=true
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
RAG_ENABLED=true
HEALTH_REQUIRE_LLM=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
